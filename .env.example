# Copy this file to .env and fill in values. Never commit .env.

# Local SQLite database file (relative to prisma/schema.prisma)
DATABASE_URL="file:./dev.db"

# Public URL of the app. Must match the Google OAuth redirect URI:
#   ${APP_URL}/api/auth/google/callback
APP_URL="http://localhost:3000"

# ─── Google sign-in (free) ──────────────────────────────────────────────
# Create an "OAuth client ID" (type: Web application) at
# https://console.cloud.google.com/apis/credentials and add the redirect URI
#   http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─── AI provider ────────────────────────────────────────────────────────
# Leave AI_PROVIDER empty to pick automatically from the keys below
# (anthropic → groq → gemini). Without any key, the app still works with
# built-in challenges and basic (clearly labelled) analysis.
AI_PROVIDER=""

# Groq — free and very fast. Key: https://console.groq.com/keys
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"

# Google Gemini — free tier (about 20 requests/day). Key: https://aistudio.google.com/apikey
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.8-flash"

# Claude (paid, optional). Key: https://console.anthropic.com
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5-5"
ANTHROPIC_EFFORT="low"
