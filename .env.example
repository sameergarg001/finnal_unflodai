# Copy this file to .env and fill in values.

# Local SQLite database file (relative to prisma/schema.prisma)
DATABASE_URL="file:./dev.db"

# AI provider: "gemini" (free tier) — more providers can be added in src/ai/
AI_PROVIDER="gemini"
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.8-flash"
