// UnfoldAI database schema.
// SQLite for local development; switch `provider` to "postgresql" later.
// Enum-like fields are stored as String (values documented inline) to stay
// portable across SQLite and Postgres.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── Users ────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String?
  googleId     String?  @unique
  image        String?  // profile picture URL (from Google)
  age          Int?
  timezone     String   @default("UTC")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  profile      UserProfile?
  sessions     Session[]
  skills       UserSkill[]
  assessments  Assessment[]
  scores       SkillScore[]
  scoreEvents  SkillScoreEvent[]
  challenges   Challenge[]
  insights     UserInsight[]
  dailyBriefs  DailyBrief[]
  weeklyReviews WeeklyReview[]
  mentorMessages MentorMessage[]
  conversations Conversation[]
  customSkills  Skill[]
  reports       Report[]
}

model UserProfile {
  userId         String   @id
  occupation     String?
  goals          String?
  about          String?
  context        Json?    // free-form onboarding answers
  onboardingDone Boolean  @default(false) // profile step done (or skipped)
  assessmentDone Boolean  @default(false) // 5 core skills self-rated
  preferences    Json?    // { theme: "dark"|"light", notifications: { activeChallenge, feedback, reports, inactiveSkill } }
  notificationsSeenAt DateTime?
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique // sha256 of the cookie token
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─── Skills ───────────────────────────────────────────────────────────────

model Skill {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  category    String  // "core" | "specific" | "custom"
  description String
  rubric      Json    // framework: { dimensions (subskills), criteria, categories, feedbackQuestions, progression }
  sortOrder   Int     @default(0)
  ownerId     String? // set for user-created custom skills

  owner       User?   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  conversations Conversation[]

  userSkills  UserSkill[]
  scores      SkillScore[]
  scoreEvents SkillScoreEvent[]
  challenges  Challenge[]
  answers     AssessmentAnswer[]
  insights    UserInsight[]
}

// Core skills are always active; specific skills can be toggled.
// Deselecting sets isActive=false so history is kept.
model UserSkill {
  userId     String
  skillId    String
  isActive   Boolean   @default(true)
  selectedAt DateTime  @default(now())
  removedAt  DateTime?
  plan       Json?     // from the first-time interview: { goal, currentLevel, timeline, targetDate, startSubskill, firstFocus, summary }
  planAt     DateTime?

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id])

  @@id([userId, skillId])
}

// ─── Assessment ───────────────────────────────────────────────────────────

model Assessment {
  id          String    @id @default(cuid())
  userId      String
  type        String    // "initial" | "periodic"
  startedAt   DateTime  @default(now())
  completedAt DateTime?

  user    User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers AssessmentAnswer[]
}

model AssessmentAnswer {
  id           String @id @default(cuid())
  assessmentId String
  skillId      String
  questionId   String
  answer       Json

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  skill      Skill      @relation(fields: [skillId], references: [id])

  @@unique([assessmentId, questionId])
}

// ─── Scores ───────────────────────────────────────────────────────────────

// Current state per user+skill.
model SkillScore {
  userId     String
  skillId    String
  score      Float    // 0–100 — UnfoldAI evidence-based score (starts at the self-rating as a baseline)
  selfScore  Float?   // 0–100 — the user's own self-assessment (not verified)
  evidenceCount Int   @default(0) // challenge assessments that fed `score`
  confidence Float    @default(0.2) // 0–1, grows with evidence
  difficulty Int      @default(2)   // 1–5, adaptive challenge difficulty
  startingLevel Int?              // 1–5, level the user chose for themselves at setup
  updatedAt  DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id])

  @@id([userId, skillId])
}

// Append-only ledger of score changes — drives progress charts and audits.
model SkillScoreEvent {
  id        String   @id @default(cuid())
  userId    String
  skillId   String
  delta     Float
  previousScore Float?
  newScore  Float
  source    String   // "assessment" (self-rating) | "challenge" (evidence)
  sourceId  String?
  reason    String?
  evidence  Json?    // { completionStatus, evidence[], signal, strength, difficulty, rule }
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id])

  @@index([userId, skillId, createdAt])
}

// ─── Challenges ───────────────────────────────────────────────────────────

model Challenge {
  id                String    @id @default(cuid())
  userId            String
  skillId           String
  conversationId    String?
  situation         String?   // the user's real-life situation this challenge addresses
  struggle          String?   // the user's current difficulty, in a sentence
  previousId        String?   // previous challenge in the same skill journey
  stepNumber        Int       @default(1)
  subskill          String?   // subskill key from the skill framework
  title             String
  objective         String?
  instructions      String
  steps             Json?     // string[] step-by-step actions
  expectedOutcome   String?
  example           String?   // optional example / conversation starter
  feedbackInstructions String?
  successCriteria   Json      // string[]
  whyThisChallenge  String?
  difficulty        Int       // 1–5
  estimatedMinutes  Int       @default(15)
  status            String    @default("proposed") // "proposed" | "active" | "done" | "abandoned" | "discarded"
  assignedAt        DateTime  @default(now())     // created
  acceptedAt        DateTime?
  dueAt             DateTime?
  completedAt       DateTime?
  generationContext Json?     // inputs given to the AI, for audits
  modelVersion      String?   // e.g. "gemini:gemini-2.5-flash" or "fallback"

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill      Skill       @relation(fields: [skillId], references: [id])
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  reflection Reflection?
  previous   Challenge?  @relation("ChallengeSteps", fields: [previousId], references: [id], onDelete: SetNull)
  next       Challenge[] @relation("ChallengeSteps")

  @@index([userId, status])
  @@index([userId, skillId, assignedAt])
}

model Reflection {
  id                  String   @id @default(cuid())
  challengeId         String   @unique
  completed           Boolean  // true for "completed" and "partial"
  completionStatus    String   @default("completed") // "completed" | "partial" | "unsuccessful" | "not_attempted"
  responses           Json?    // [{ question, answer }]
  selfRating          Int?     // 1–5 (optional)
  perceivedDifficulty Int?     // 1–5 (optional)
  whatHappened        String
  whatWasHard         String?
  whatLearned         String?
  createdAt           DateTime @default(now())

  challenge Challenge   @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  analysis  AiAnalysis?
}

model AiAnalysis {
  id                       String   @id @default(cuid())
  reflectionId             String   @unique
  evidence                 Json     // string[]
  skillSignal              Float    // -1..1, how well the attempt demonstrated the skill
  evidenceStrength         Float    // 0..1
  difficultyRecommendation String   // "easier" | "same" | "harder"
  painPoints               Json     // string[] — specific weaknesses identified from this attempt
  nextFocus                String?  // what the next step should target
  insights                 Json     // { items: [{ kind, text }], feedback }
  report                   Json?    // { wentWell[], toImprove[], nextFocus, nextSubskill, overcamePrevious }
  modelVersion             String
  createdAt                DateTime @default(now())

  reflection Reflection @relation(fields: [reflectionId], references: [id], onDelete: Cascade)
}

// ─── Long-term memory ─────────────────────────────────────────────────────

// Compact, deduplicated facts about the user that feed future prompts.
model UserInsight {
  id         String   @id @default(cuid())
  userId     String
  skillId    String?
  kind       String   // "strength" | "blocker" | "pattern" | "preference"
  text       String
  strength   Float    @default(0.5) // 0–1, decays over time, reinforced on repeat
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill Skill? @relation(fields: [skillId], references: [id])

  @@index([userId, skillId])
}

// ─── Daily mentor ─────────────────────────────────────────────────────────

// The mentor's personal greeting for one local day (generated once per day).
model DailyBrief {
  id           String   @id @default(cuid())
  userId       String
  date         String   // YYYY-MM-DD in the user's timezone
  message      String
  focus        String
  skillId      String?  // skill the mentor suggests for today
  modelVersion String
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

// Weekly progress summary from the mentor (refreshed at most once a day).
model WeeklyReview {
  id           String   @id @default(cuid())
  userId       String
  weekStart    String   // YYYY-MM-DD (Monday) in the user's timezone
  content      Json     // { summary, wins[], mainPainPoint, nextWeekFocus }
  modelVersion String
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, weekStart])
}

// "Ask your mentor" chat. challengeId set = conversation about that step.
model MentorMessage {
  id          String   @id @default(cuid())
  userId      String
  challengeId String?
  role        String   // "user" | "mentor"
  content     String
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, challengeId, createdAt])
}

// ─── AI coach conversations (one thread per skill session) ────────────────

model Conversation {
  id        String   @id @default(cuid())
  userId    String
  skillId   String
  status    String   @default("open")          // "open" | "closed"
  phase     String   @default("understanding") // "understanding" | "proposed" | "active" | "feedback" | "reviewed"
  summary   String?  // running summary of the user's situation & barriers
  context   Json?    // { situation, barriers[], goal } gathered so far
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill      Skill                 @relation(fields: [skillId], references: [id], onDelete: Cascade)
  messages   ConversationMessage[]
  challenges Challenge[]

  @@index([userId, skillId, updatedAt])
}

model ConversationMessage {
  id             String   @id @default(cuid())
  conversationId String
  role           String   // "user" | "coach"
  kind           String   @default("text") // "text" | "challenge" | "report" | "event"
  content        String
  challengeId    String?
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

// AI progress reviews ("what you improved / what still needs work / focus next").
// skillId null = overall review. Regenerated when new evidence exists.
model Report {
  id          String   @id @default(cuid())
  userId      String
  skillId     String?
  reportData  Json     // { improved[], stillNeedsWork[], focusNext, basedOn }
  evidenceKey String   // fingerprint of the evidence it was built from
  modelVersion String
  generatedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, skillId, generatedAt])
}
